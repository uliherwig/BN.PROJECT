    "version": "0.2.0",
    "configurations": [        
        {
            "name": "IdentityService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/IdentityService/bin/Debug/net9.0/IdentityService.dll",
            "cwd": "${workspaceFolder}/IdentityService",
            "stopAtEntry": false,
            "requireExactSource": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "NotificationService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/NotificationService/bin/Debug/net9.0/NotificationService.dll",
            "cwd": "${workspaceFolder}/NotificationService",
            "stopAtEntry": false,
            "requireExactSource": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "AlpacaService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/AlpacaService/bin/Debug/net9.0/AlpacaService.dll",
            "cwd": "${workspaceFolder}/AlpacaService",
            "stopAtEntry": false,
            "requireExactSource": false,
            // "preLaunchTask": "build",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "StrategyService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/StrategyService/bin/Debug/net9.0/StrategyService.dll",
            "cwd": "${workspaceFolder}/StrategyService",
            "stopAtEntry": false,
            "requireExactSource": false,
            // "preLaunchTask": "build",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
           
    ],
    "compounds": [
        {
            "name": "Start All Services",
            "configurations": [
     
                "AlpacaService",
                "StrategyService"
            ]
        }
    ]
}